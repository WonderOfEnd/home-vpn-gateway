[Unit]
Description=pcstate: при входе выбрать лучший снимок, при выключении усыпить ВМ
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/pcstate rotate
ExecStop=%h/.local/bin/pcstate vmsave
TimeoutStopSec=180

[Install]
WantedBy=graphical-session.target
