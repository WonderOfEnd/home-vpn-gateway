#!/usr/bin/env python3
"""pcstate: снимок и восстановление состояния ПК (приложения, окна Konsole, ВМ).
Команды: snapshot | rotate | restore [--dry] | vmsave | show"""
import json, os, re, subprocess, sys, time, glob, shutil

ST = os.path.expanduser("~/.local/state/pcstate")
SNAPS, HIST, SAVED = f"{ST}/snaps", f"{ST}/history", f"{ST}/saved.json"
URI = "qemu:///system"
APP_RE = re.compile(r"^app-(?P<id>.+)@[0-9a-f]{32}\.service$")  # только приложения, запущенные пользователем (не @autostart)

def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout

def unescape(s):  # systemd пишет '-' как \x2d
    return re.sub(r"\\x([0-9a-f]{2})", lambda m: chr(int(m.group(1), 16)), s)

def running_apps():
    apps = []
    out = sh("systemctl", "--user", "list-units", "app-*", "--type=service", "--state=running", "--plain", "--no-legend")
    for line in out.splitlines():
        unit = line.split()[0]
        m = APP_RE.match(unit)
        if not m:
            continue
        app = {"id": unescape(m["id"])}
        pid = sh("systemctl", "--user", "show", "-p", "MainPID", "--value", unit).strip()
        if app["id"] == "org.kde.konsole" and pid.isdigit():
            app["cwds"] = konsole_cwds(pid)
        apps.append(app)
    return apps

def konsole_cwds(pid):
    cwds = []
    for child in sh("pgrep", "-P", pid).split():
        try:
            cwds.append(os.readlink(f"/proc/{child}/cwd"))
        except OSError:
            pass
    return cwds

def running_vms():
    return [v for v in sh("virsh", "-c", URI, "list", "--name").split("\n") if v.strip()]

def snapshot():
    state = {"time": int(time.time()), "apps": running_apps(), "vms": running_vms()}
    if not state["apps"] and not state["vms"]:
        return  # пустое состояние не пишем, чтобы не затереть полезное
    with open(f"{SNAPS}/{state['time']}.json", "w") as f:
        json.dump(state, f, ensure_ascii=False)
    for old in sorted(glob.glob(f"{SNAPS}/*.json"))[:-8]:  # храним последние 8 (~2 минуты)
        os.remove(old)

def load(p):
    with open(p) as f:
        return json.load(f)

def rotate():
    """При входе: выбираем лучший снимок. В момент выключения приложения закрываются постепенно,
    поэтому берём снимок с максимумом приложений среди последних ~60 с перед концом."""
    files = sorted(glob.glob(f"{SNAPS}/*.json"))
    if not files:
        return
    snaps = [load(p) for p in files]
    newest = snaps[-1]["time"]
    recent = [s for s in snaps if newest - s["time"] <= 60]
    best = max(recent, key=lambda s: (len(s["apps"]) + len(s["vms"]), s["time"]))
    if os.path.exists(SAVED):
        shutil.copy(SAVED, f"{HIST}/saved-{int(os.path.getmtime(SAVED))}.json")
    with open(SAVED, "w") as f:
        json.dump(best, f, ensure_ascii=False)
    for p in files:
        os.remove(p)
    for old in sorted(glob.glob(f"{HIST}/*.json"))[:-10]:
        os.remove(old)

def vmsave():
    for vm in running_vms():
        subprocess.run(["virsh", "-c", URI, "managedsave", vm])  # RAM ВМ -> файл, ВМ останавливается

def notify(msg):
    subprocess.run(["notify-send", "-i", "system-reboot", "Состояние ПК", msg])

def restore(dry=False):
    if not os.path.exists(SAVED):
        notify("Нет сохранённого состояния")
        return
    st = load(SAVED)
    have_vms, have_apps = set(running_vms()), {a["id"] for a in running_apps()}
    log = []
    for vm in st["vms"]:
        if vm not in have_vms:
            log.append(f"ВМ {vm}")
            if not dry:
                subprocess.run(["virsh", "-c", URI, "start", vm])  # при наличии managedsave — продолжит с того же места
    for a in st["apps"]:
        if a["id"] == "org.kde.konsole" and a.get("cwds"):
            log.append(f"Konsole x{len(a['cwds'])}")
            if not dry and a["id"] not in have_apps:
                for d in a["cwds"]:
                    subprocess.Popen(["konsole", "--workdir", d], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    time.sleep(0.7)
            continue
        if a["id"] in have_apps:
            continue
        log.append(a["id"])
        if not dry:
            subprocess.Popen(["gtk-launch", a["id"]], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    msg = "Вернул: " + (", ".join(log) if log else "всё уже запущено")
    print(msg)
    if not dry:
        notify(msg)

cmd = sys.argv[1] if len(sys.argv) > 1 else "show"
os.makedirs(SNAPS, exist_ok=True); os.makedirs(HIST, exist_ok=True)
if cmd == "snapshot": snapshot()
elif cmd == "rotate": rotate()
elif cmd == "vmsave": vmsave()
elif cmd == "restore": restore("--dry" in sys.argv)
else: print(json.dumps(load(SAVED), ensure_ascii=False, indent=1) if os.path.exists(SAVED) else "нет saved.json")
