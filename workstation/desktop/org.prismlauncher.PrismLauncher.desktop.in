[Desktop Entry]
Version=1.0
Name=Prism Launcher
Comment=Discover, manage, and play Minecraft instances
Type=Application
Terminal=false
Exec="<PRISM_DIR>/PrismLauncher" %U
StartupNotify=true
Icon=<PRISM_DIR>/share/icons/hicolor/256x256/apps/org.prismlauncher.PrismLauncher.png
Categories=Game;
Keywords=game;minecraft;mc;
StartupWMClass=PrismLauncher
Path=<PRISM_DIR>
