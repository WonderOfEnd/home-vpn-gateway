[Unit]
Description=Deliver personal gateway mode notifications through ntfy
After=network-online.target
ConditionPathExists=/etc/home-net/ntfy.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/home-net-notify.py
StateDirectory=home-net-notify
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
